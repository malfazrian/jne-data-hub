# Copy this file to .env and fill with your local/internal values
# .env is ignored by git via .gitignore

# Local-only configuration (do not commit)
FLASK_SECRET_KEY=<SECRET_KEY>
APP_HOST=0.0.0.0
APP_PORT=5000
APP_THREADS=100

# Data source paths
CSV_BASE_PATH=\\<INTERNAL_SERVER>
PARQUET_BASE_PATH=\\<INTERNAL_SERVER>\D\<LOCAL_USER>\parquet_db
PARQUET_SOURCE_BASE=\\<INTERNAL_SERVER>\<ARCHIVE_FOLDER>
PROCESS_HISTORY_SOURCE=D:\<LOCAL_USER>\Python_Scripts\Bot_Report_Gabungan\utils\data\process_history.json
PARQUET_PROCESSED_FILE=D:\<LOCAL_USER>\Python_Scripts\Parquet_DB\processed_files.json
REPORT_EXPLORER_BASE=\\<INTERNAL_SERVER>\<REPORT_FOLDER>

# Reference file paths
TABLE_REFERENCE_PATH=\\<INTERNAL_SERVER>\D\<USER_FOLDER>\references\Table_Reference.xlsx
HOLIDAY_REFERENCE_PATH=\\<INTERNAL_SERVER>\D\<USER_FOLDER>\references\Holiday.xlsx
REFERENCE_BASE_PATH=\\<INTERNAL_SERVER>\D\<USER_FOLDER>\references
PROJECT_REF_SOURCE=\\<INTERNAL_SERVER>\<UPDATE_FOLDER>\Reference\Tabel_Reference.xlsx

# APEX configuration
APEX_DEFAULT_HOSTS=<APEX_HOST_LIST>
APEX_UPLOAD_HOSTS=<APEX_UPLOAD_HOST_LIST>
APEX_URL_TEMPLATE=https://dash-<HOST>.example.com/apex/f?p=XXX
APEX_USERNAME=<APEX_USERNAME>
APEX_PASSWORD=<APEX_PASSWORD>
