# Copy this file to .env and fill with your local/internal values
# .env is ignored by git via .gitignore

# Flask app
FLASK_SECRET_KEY=change-me-before-production
APP_HOST=0.0.0.0
APP_PORT=5000
APP_THREADS=100

# Data source paths
CSV_BASE_PATH=
PARQUET_BASE_PATH=
PARQUET_SOURCE_BASE=
PROCESS_HISTORY_SOURCE=
PARQUET_PROCESSED_FILE=
REPORT_EXPLORER_BASE=

# Reference file paths
TABLE_REFERENCE_PATH=
HOLIDAY_REFERENCE_PATH=
REFERENCE_BASE_PATH=
PROJECT_REF_SOURCE=

# APEX configuration (comma-separated fallback hosts)
APEX_DEFAULT_HOSTS=
APEX_UPLOAD_HOSTS=
APEX_URL_TEMPLATE=
APEX_USERNAME=
APEX_PASSWORD=
